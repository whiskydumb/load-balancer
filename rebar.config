{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_export_vars,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_unused_import,
    warn_missing_spec
]}.

{deps, []}.

{project_plugins, [
    {erlfmt, "1.8.0"}
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "config/*.config",
        "{src,include,test}/**/*.{erl,hrl,app.src}"
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [
        error_handling,
        extra_return,
        unmatched_returns
    ]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [lb]}
]}.

{relx, [
    {release, {lb, "0.1.0"}, [lb, runtime_tools]},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {mode, dev}
]}.

{profiles, [
    {prod, [
        {relx, [{mode, prod}]}
    ]},
    {test, [
        {deps, [{proper, "1.5.0"}]},
        {erl_opts, [nowarn_missing_spec]}
    ]}
]}.
